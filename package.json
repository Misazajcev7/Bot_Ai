{
  "name": "ai-minecraft-bot",
  "version": "1.0.0",
  "description": "Autonomous, sarcastic AI-driven Mineflayer bot — pathfinding, LOS-gated mining, PvP/dodging, furnace & crafting automation, VLM screen vision, and RU/EN voice control. Tuned to run inside a 512MB RAM container.",
  "main": "bot.js",
  "private": true,
  "scripts": {
    "start": "node --max-old-space-size=400 --expose-gc bot.js",
    "start:verbose": "node --max-old-space-size=400 --expose-gc --trace-gc bot.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "mineflayer": "^4.20.1",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-collectblock": "^1.6.0",
    "minecraft-data": "^3.68.0",
    "say": "^0.16.0",
    "screenshot-desktop": "^1.15.0",
    "node-fetch": "^2.7.0",
    "vec3": "^0.1.10"
  }
}
